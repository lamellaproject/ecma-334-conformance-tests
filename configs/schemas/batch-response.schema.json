{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "batch-response schema v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "programs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "exit": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "enum": [
                  "timeout",
                  "launch-error"
                ]
              }
            ]
          },
          "stdout": {
            "type": "string"
          },
          "stderr": {
            "type": "string"
          },
          "elapsed_seconds": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "exit",
          "stdout",
          "stderr",
          "elapsed_seconds"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "programs"
  ],
  "additionalProperties": false
}
