{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "batch-request schema v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "programs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "entry": {
            "type": "string"
          },
          "arguments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "artifacts": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "timeout_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "id",
          "entry",
          "arguments",
          "artifacts",
          "timeout_seconds"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "programs"
  ],
  "additionalProperties": false
}
