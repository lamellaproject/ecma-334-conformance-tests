    "libraries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z_0-9]*$"
          },
          "units": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string"
                },
                "defines": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z_0-9]*$"
                  },
                  "uniqueItems": true
                }
              },
              "required": [
                "source"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "references": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "library": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z_0-9]*$"
                },
                "asset": {
                  "type": "string"
                },
                "alias": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z_0-9]*$"
                }
              },
              "required": [],
              "additionalProperties": false,
              "oneOf": [
                {
                  "required": [
                    "library"
                  ]
                },
                {
                  "required": [
                    "asset"
                  ]
                }
              ]
            }
          }
        },
        "required": [
          "name",
          "units"
        ],
        "additionalProperties": false
      }
    },
    "program": {
      "type": "object",
      "properties": {
        "units": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string"
              },
              "defines": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z_0-9]*$"
                },
                "uniqueItems": true
              }
            },
            "required": [
              "source"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "library": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z_0-9]*$"
              },
              "asset": {
                "type": "string"
              },
              "alias": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z_0-9]*$"
              }
            },
            "required": [],
            "additionalProperties": false,
            "oneOf": [
              {
                "required": [
                  "library"
                ]
              },
              {
                "required": [
                  "asset"
                ]
              }
            ]
          }
        },
        "entry_point": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "arguments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_requires": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "required": [],
  "additionalProperties": false
}
