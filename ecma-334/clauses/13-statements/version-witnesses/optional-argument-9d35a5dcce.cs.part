// Positive compilation witness for E13-9-5-getenumerator-overload-resolution.
// An explicit invocation retains the optional parameter and omitted argument without relying on foreach overload selection.
using System;
class Program
{
    static int checks, failures;
    static void Check(bool ok, string id) { checks++; if (!ok) { failures++; Console.WriteLine("FAIL " + id); } }
    class Source
    {
        public Cursor GetEnumerator(int value = 37) { return new Cursor { Number = value }; }
    }
    class Cursor
    {
        public int Number;
        int position;
        public int Current { get { return Number; } }
        public bool MoveNext() { return ++position == 1; }
    }
    static void Main()
    {
        int total = 0, visits = 0;
        foreach (int item in new int[] { new Source().GetEnumerator().Current }) { total += item; visits++; }
        Check(total == 37, "getenumerator-optional-argument-default");
        Check(visits == 1, "optional-getenumerator-is-applicable-to-empty-list");
        if (failures == 0) Console.WriteLine("OK " + checks);
    }
}
