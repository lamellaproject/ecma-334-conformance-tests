using System;
class Program
{
    static int checks, failures;
    static void Check(bool ok, string name)
    {
        checks++;
        if (!ok) { failures++; Console.WriteLine("FAIL " + name); }
    }
    delegate int Reader();
    class Source { public int ReadValue() { return 43; } }
    static Source receiver = new Source();
    static Reader Convert() { return receiver.ReadValue; }
    static int Main()
    {
        Reader first = Convert();
        Reader second = Convert();
        Check(first() == 43 && second() == 43, "method-group-target");
        Check(!object.ReferenceEquals(first, second), "fresh-implicit-delegates");
        if (failures == 0) Console.WriteLine("OK " + checks);
        return failures == 0 ? 0 : 1;
    }
}
