// Positive compilation witness for E10-8-null-instance.
// The causal mutation removes the departure's disputed part while retaining the program's remaining construct prerequisites.
using System;
class Receiver { public void Touch() { } }
class Program
{
    static int checks, failures;
    static void Check(bool ok, string id) { checks++; if (!ok) { failures++; Console.WriteLine("FAIL " + id); } }
    static void Main()
    {
        Receiver receiver = null;
        try
        {
            Action converted = new Receiver().Touch;
            Check(false, "null-receiver/required-exception");
        }
        catch (NullReferenceException)
        {
            Check(true, "null-receiver/required-exception");
        }
        catch (Exception error)
        {
            Check(false, "null-receiver/exception-type");
            Console.WriteLine("EXCEPTION " + error.GetType().FullName);
        }
        if (failures == 0) Console.WriteLine("OK " + checks);
    }
}
