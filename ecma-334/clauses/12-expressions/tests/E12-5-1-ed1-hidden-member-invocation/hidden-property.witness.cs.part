// ECMA-334 1st ed 14.3, p. 129 (PDF p. 143), lines 18-31. A derived non-delegate field,
// property or constant, or a nested type, hides all base members of that name before
// invocation is checked.
using System;
class Meter
{
    public int Read() { return 42; }
}
class Gauge : Meter
{
    public new int Read { get { return 9; } }
}
class Entry
{
    static int checks;
    static int failures;
    static void Check(bool result, string label)
    {
        checks++;
        if (!result)
        {
            failures++;
            Console.WriteLine("FAIL " + label);
        }
    }
    static int Main()
    {
        Check(((Meter)new Gauge()).Read() == 42, "base-method");
        if (failures == 0) Console.WriteLine("OK " + checks);
        return failures == 0 ? 0 : 1;
    }
}
