// ECMA-334 1st ed 14.5.4, p. 141 (PDF p. 155), lines 5-8 and 34-37. Within its declaring
// type, a field-like event is processed as its static or instance field in every field
// context, including compound assignment.
using System;
delegate void Pulse();
class Source
{
    public event Pulse Signal;
    public Pulse Attach(Pulse callback)
    {
        Pulse result = (this.Signal = this.Signal + callback);
        return result;
    }
    public Pulse Read() { return this.Signal; }
}
class Entry
{
    static int checks;
    static int failures;
    static void Check(bool result, string label)
    {
        checks++;
        if (!result)
        {
            failures++;
            Console.WriteLine("FAIL " + label);
        }
    }
    static void Handle() { }
    static int Main()
    {
        Source source = new Source();
        Pulse callback = new Pulse(Handle);
        Pulse result = source.Attach(callback);
        Check(result == callback, "assignment-value");
        Check(source.Read() == callback, "field-value");
        if (failures == 0) Console.WriteLine("OK " + checks);
        return failures == 0 ? 0 : 1;
    }
}
