// ECMA-334 3rd ed 14.10.4, p. 213 (PDF p. 233).
using System;
class Program
{
    static int checks, failures;
    static void Check(bool ok, string id)
    {
        checks++;
        if (!ok) { failures++; Console.WriteLine("FAIL " + id); }
    }
    static int Select(bool? gate) { if (gate == true) return 7; return 3; }
    static int Main()
    {
        Check(Select(true) == 7, "true-condition");
        Check(Select(false) == 3, "false-condition");
        Check(Select(null) == 3, "null-condition");
        if (failures == 0) Console.WriteLine("OK " + checks);
        return failures == 0 ? 0 : 1;
    }
}
