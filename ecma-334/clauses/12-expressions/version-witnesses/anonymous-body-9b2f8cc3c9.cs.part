// Positive compilation witness for E12-8-19-lexical.
// The causal mutation removes the departure's disputed part while retaining the program's remaining construct prerequisites.
using System;
class Program
{
    static int checks, failures;
    static void Check(bool ok, string id) { checks++; if (!ok) { failures++; Console.WriteLine("FAIL " + id); } }
    static void Main()
    {
        int n = 256;
        Func<byte> getter;
        checked { getter = () => (byte)1; }
        try
        {
            Check(getter() == 0, "anonymous-body/wrapped-value");
        }
        catch (Exception error)
        {
            Check(false, "anonymous-body/unexpected-exception");
            Console.WriteLine("EXCEPTION " + error.GetType().FullName);
        }
        if (failures == 0) Console.WriteLine("OK " + checks);
    }
}
