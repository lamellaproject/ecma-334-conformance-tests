class Ticket
{
    public readonly int Code;
    Ticket(int code) { Code = code; }
    public static implicit operator Ticket(int code) { return new Ticket(code); }
}
class Program
{
    static Ticket Issue(int code) => code;
    static int Main()
    {
        int checks = 0;
        int failures = 0;
        checks++;
        if (!(Issue(11).Code == 11))
        {
            failures++;
            System.Console.WriteLine("FAIL converted-ticket-code");
        }
        if (failures == 0) System.Console.WriteLine("OK " + checks);
        return failures == 0 ? 0 : 1;
    }
}
