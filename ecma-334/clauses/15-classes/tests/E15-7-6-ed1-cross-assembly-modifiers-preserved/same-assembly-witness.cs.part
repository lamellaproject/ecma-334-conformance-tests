// Positive prerequisite witness for the same-access override construct.
// Its base declaration is in this compilation, so this does not certify
// the original cross-assembly condition or give it a different oracle.
public class LocalRoot
{
    protected internal virtual int Signal { get { return 1; } }
}
// Old 17.6.3, p. 248 (PDF p. 262), lines 23-24 requires matching declared accessibility.
